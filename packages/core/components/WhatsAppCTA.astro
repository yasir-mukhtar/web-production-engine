---
interface Props {
  headline: string;
  description: string;
  whatsappHref: string;
  ctaLabel: string;
}

const { headline, description, whatsappHref, ctaLabel } = Astro.props;
---

<section class="bg-primary py-section">
  <div class="mx-auto max-w-4xl px-6 text-center">
    <h2 class="font-display text-h2 text-surface">{headline}</h2>
    <p class="mx-auto mt-4 max-w-2xl font-body text-body text-surface/90">{description}</p>
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener"
      class="mt-10 inline-block rounded-button bg-surface px-8 py-4 font-body text-body font-semibold text-primary transition-colors duration-fast ease-standard hover:opacity-90"
    >
      {ctaLabel}
    </a>
  </div>
</section>
