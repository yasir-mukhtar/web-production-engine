---
import type { ImageMetadata } from 'astro';

interface SiteShape {
  name: string;
  tagline: string;
  logo: ImageMetadata;
  address: { street: string; city: string; province: string; postal_code: string };
  geo: { lat: number; lng: number };
  hours: string;
  phone: string;
  socials: { instagram?: string; facebook?: string; tiktok?: string; linkedin?: string };
  contact: { whatsapp_number: string; whatsapp_default_message: string };
  seo: { title_template: string; description: string; og_image: ImageMetadata };
}

interface Props {
  site: SiteShape;
  /** Page name substituted into the title template ({page}). */
  pageTitle: string;
  pageDescription?: string;
  /** LocalBusiness specialisation — per-site business fact, passed in code.
   *  FINDING (Phase 8 Task 1): this union was site-2-shaped; site 3 needed
   *  CafeOrCoffeeShop; site 4 (Masryef, real client prototype) needed
   *  FinancialService. The vocabulary grows with each real client — a
   *  Rule-of-Three candidate for moving into the shared schema as content. */
  businessType: 'Dentist' | 'GeneralContractor' | 'CafeOrCoffeeShop' | 'FinancialService';
  /** Absolute base URL; canonical/OG-url/JSON-LD url+logo are emitted only
   *  when it is set (real domains arrive after deploy). */
  baseUrl?: string;
  /** Path of the current page, for canonical. Defaults to homepage. */
  path?: string;
  /** Language of the site, for Open Graph. Defaults to the Indonesian
   *  market (first three spike sites); international clients override.
   *  FINDING (site 4): the spike hardcoded id_ID — a KL client is en_MY. */
  ogLocale?: string;
  /** ISO country code for JSON-LD addressCountry. FINDING (site 4): the
   *  spike hardcoded ID — address lives in content but the country did
   *  not, so it leaked into code. Default keeps the spike sites identical. */
  countryCode?: string;
}

const { site, pageTitle, pageDescription, businessType, baseUrl = '', path = '/', ogLocale = 'id_ID', countryCode = 'ID' } = Astro.props;

const title = site.seo.title_template.replace('{page}', pageTitle);
const description = pageDescription ?? site.seo.description;
const ogImageSrc = site.seo.og_image.src;
const logoSrc = site.logo.src;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': businessType,
  name: site.name,
  ...(baseUrl ? { url: `${baseUrl}${path}` } : {}),
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.province,
    postalCode: site.address.postal_code,
    addressCountry: countryCode,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.geo.lat,
    longitude: site.geo.lng,
  },
  openingHours: site.hours,
  ...(baseUrl
    ? { image: `${baseUrl}${ogImageSrc}`, logo: `${baseUrl}${logoSrc}` }
    : {}),
};
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content="index, follow" />
{baseUrl && <link rel="canonical" href={`${baseUrl}${path}`} />}
{baseUrl && <link rel="sitemap" href={`${baseUrl}sitemap-index.xml`} />}

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{baseUrl && <meta property="og:url" content={`${baseUrl}${path}`} />}
<meta property="og:image" content={baseUrl ? `${baseUrl}${ogImageSrc}` : ogImageSrc} />
<meta property="og:locale" content={ogLocale} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={baseUrl ? `${baseUrl}${ogImageSrc}` : ogImageSrc} />

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
