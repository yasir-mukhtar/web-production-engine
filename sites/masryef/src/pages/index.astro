---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/inter';
import SiteHead from '@wps/core/components/SiteHead.astro';
import SiteHeader from '@wps/core/components/SiteHeader.astro';
import Hero from '@wps/core/components/Hero.astro';
import ServicesGrid from '@wps/core/components/ServicesGrid.astro';
import FAQ from '@wps/core/components/FAQ.astro';
import WhatsAppCTA from '@wps/core/components/WhatsAppCTA.astro';
import SiteFooter from '@wps/core/components/SiteFooter.astro';
import Accolades from '../site-local/Accolades.astro';
import { whatsappHref } from '@wps/core/lib/whatsapp';
import { getCollection } from 'astro:content';
import heroImg from '../assets/hero.png';
import '../styles/global.css';

const [siteEntry] = await getCollection('site');
const [homeEntry] = await getCollection('home');
const site = siteEntry.data;
const home = homeEntry.data;
const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ title: s.data.title, summary: s.data.summary, image: s.data.image, durasi_estimasi: s.data.durasi_estimasi }));
const faqs = (await getCollection('faq')).map((f) => f.data);
const accolades = (await getCollection('accolades'))
  .sort((a, b) => b.data.year - a.data.year)
  .map((a) => ({ title: a.data.title, awarder: a.data.awarder, year: a.data.year, image: a.data.image }));

const credentials = [
  'Registered Shariah Advisor — Securities Commission Malaysia',
  'Shariah Advisor Panel — MDEC',
  'Associate Member — Fintech Association of Malaysia',
];

const href = whatsappHref(site.contact.whatsapp_number, site.contact.whatsapp_default_message);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteHead site={site} pageTitle="Home" businessType="FinancialService" ogLocale="en_MY" countryCode="MY" />
  </head>
  <body>
    <SiteHeader name={site.name} tagline={site.tagline} logo={site.logo} whatsappHref={href} ctaLabel={home.hero.cta_label} />
    <main>
      {/** Advisory firm: authority first. Hero → recognition → services. */}
      <Hero
        headline={home.hero.headline}
        subheadline={home.hero.subheadline}
        image={heroImg}
        ctaLabel={home.hero.cta_label}
        whatsappHref={href}
      />
      <Accolades credentials={credentials} accolades={accolades} />
      <ServicesGrid intro={home.services_intro} services={services} />
      <FAQ intro={home.faq_intro} faqs={faqs} />
      <WhatsAppCTA
        headline={`Let's build your Shariah-compliant product`}
        description="From product ideation to Shariah endorsement and audit — discuss your engagement with our practitioners on WhatsApp."
        whatsappHref={href}
        ctaLabel={home.hero.cta_label}
      />
    </main>
    <SiteFooter
      name={site.name}
      tagline={site.tagline}
      address={site.address}
      hours={site.hours}
      phone={site.phone}
      socials={site.socials}
      contact={site.contact}
      labels={{
        addressTitle: 'Address & hours',
        contactTitle: 'Contact us',
        whatsapp: 'WhatsApp',
        phoneLabel: 'Phone',
        copyrightSuffix: 'All rights reserved.',
      }}
    />
  </body>
</html>
