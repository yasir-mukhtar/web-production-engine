---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { whatsappHref } from '@wps/core/lib/whatsapp';

interface Dokter {
  name: string;
  specialty: string;
  bio: string;
  photo: ImageMetadata;
}

interface Props {
  doctors: Dokter[];
  whatsappNumber: string;
}

const { doctors, whatsappNumber } = Astro.props;
---

<section class="bg-surface py-section">
  <div class="mx-auto max-w-6xl px-6">
    <h2 class="font-display tracking-display text-h2 text-ink">Tim dokter kami</h2>
    <p class="mt-4 max-w-2xl font-body text-body text-muted">
      Kenalan dulu sebelum perawatan. Setiap dokter di sini punya cara bicara yang sama jujurnya: apa yang ditemukan, kenapa, dan berapa biayanya.
    </p>
    <ul class="mt-12 grid gap-gutter md:grid-cols-2">
      {
        doctors.map((d) => (
          <li class="reveal flex gap-6 rounded-card border-card border-line bg-surface-alt p-card shadow-card">
            <Picture
              src={d.photo}
              widths={[160, 320]}
              sizes="96px"
              formats={['avif', 'webp']}
              alt={d.name}
              loading="lazy"
              class="h-24 w-24 shrink-0 rounded-image object-cover"
            />
            <div class="min-w-0">
              <h3 class="font-display tracking-display text-h3 text-ink">{d.name}</h3>
              <p class="font-body text-small text-primary">{d.specialty}</p>
              <p class="mt-2 font-body text-body text-muted">{d.bio}</p>
              <a
                href={whatsappHref(whatsappNumber, `Halo, saya ingin konsultasi dengan ${d.name}`)}
                target="_blank"
                rel="noopener"
                class="mt-3 inline-block rounded-button bg-primary px-4 py-2 font-body text-small font-semibold text-surface transition-colors duration-fast ease-standard hover:opacity-90"
              >
                Chat {d.name.split(' ')[0]}
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
  <style>
    /* Scroll-triggered reveal, zero JS: CSS scroll-driven animation where
       supported (progressive enhancement — static when not). */
    @supports (animation-timeline: view()) {
      .reveal {
        animation: rise 700ms var(--ease-enter) both;
        animation-timeline: view();
        animation-range: entry 10% entry 45%;
      }
    }
    @keyframes rise {
      from { opacity: 0; transform: translateY(16px); }
      to { opacity: 1; transform: none; }
    }
  </style>
</section>
