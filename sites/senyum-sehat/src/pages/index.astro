---
import '@fontsource-variable/plus-jakarta-sans';
import Hero from '@wps/core/components/Hero.astro';
import ServicesGrid from '@wps/core/components/ServicesGrid.astro';
import { getCollection } from 'astro:content';
import heroImg from '../assets/hero.jpg';
import '../styles/global.css';

const [siteEntry] = await getCollection('site');
const [homeEntry] = await getCollection('home');
const site = siteEntry.data;
const hero = homeEntry.data.hero;
const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ title: s.data.title, summary: s.data.summary, image: s.data.image }));

// E.164 digits only: no "+", no leading zero. Message is URL-encoded.
const whatsappHref =
  `https://wa.me/${site.contact.whatsapp_number}` +
  `?text=${encodeURIComponent(site.contact.whatsapp_default_message)}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{site.name}</title>
  </head>
  <body>
    <Hero
      headline={hero.headline}
      subheadline={hero.subheadline}
      image={heroImg}
      ctaLabel={hero.cta_label}
      whatsappHref={whatsappHref}
    />
    <ServicesGrid intro={homeEntry.data.services_intro} services={services} />
  </body>
</html>
