---
import '@fontsource-variable/plus-jakarta-sans';
import SiteHead from '@wps/core/components/SiteHead.astro';
import SiteHeader from '@wps/core/components/SiteHeader.astro';
import Hero from '@wps/core/components/Hero.astro';
import ServicesGrid from '@wps/core/components/ServicesGrid.astro';
import Testimonials from '@wps/core/components/Testimonials.astro';
import FAQ from '@wps/core/components/FAQ.astro';
import WhatsAppCTA from '@wps/core/components/WhatsAppCTA.astro';
import SiteFooter from '@wps/core/components/SiteFooter.astro';
import { whatsappHref } from '@wps/core/lib/whatsapp';
import { getCollection } from 'astro:content';
import heroImg from '../assets/hero.jpg';
import '../styles/global.css';

const [siteEntry] = await getCollection('site');
const [homeEntry] = await getCollection('home');
const site = siteEntry.data;
const home = homeEntry.data;
const services = (await getCollection('services'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((s) => ({ title: s.data.title, summary: s.data.summary, image: s.data.image }));
const testimonials = (await getCollection('testimonials')).map((t) => t.data);
const faqs = (await getCollection('faq')).map((f) => f.data);

const href = whatsappHref(site.contact.whatsapp_number, site.contact.whatsapp_default_message);
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SiteHead site={site} pageTitle="Beranda" businessType="Dentist" />
  </head>
  <body>
    <SiteHeader name={site.name} tagline={site.tagline} logo={site.logo} whatsappHref={href} ctaLabel={home.hero.cta_label} />
    <main>
      <Hero
        headline={home.hero.headline}
        subheadline={home.hero.subheadline}
        image={heroImg}
        ctaLabel={home.hero.cta_label}
        whatsappHref={href}
      />
      <ServicesGrid intro={home.services_intro} services={services} />
      <Testimonials intro={home.testimonials_intro} testimonials={testimonials} />
      <FAQ intro={home.faq_intro} faqs={faqs} />
      <WhatsAppCTA
        headline={`Siap memulai perawatan gigi Anda?`}
        description="Chat kami di WhatsApp, sampaikan keluhan Anda, dan admin kami akan menjadwalkan kunjungan pertama Anda."
        whatsappHref={href}
        ctaLabel={home.hero.cta_label}
      />
    </main>
    <SiteFooter name={site.name} tagline={site.tagline} address={site.address} hours={site.hours} phone={site.phone} socials={site.socials} contact={site.contact} />
  </body>
</html>
